      { nome: 'Env. Arquivo', plan: ['ENV ARQUIVO PLAN'], real: ['ENV ARQUIVO REAL'] },
      { nome: 'Rec. Boneco', plan: ['REC BONECO PLAN'], real: ['REC BONECO REAL'] },
