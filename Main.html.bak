            grafica: String(l["GRAFICA_FINAL"] || l["GRÁFICA"] || "N/A").trim(),
            marca: String(l["UNIDADE"] || l["MARCA_FINAL"] || "N/A").trim(),
            serie: String(l["SÉRIE"] || l["Série"] || l["SERIE"] || "-").trim(),
            sku: String(l["SKU_REAL"] || l["SKU"] || "-").trim(),
            desc: desc,
            status: statusFinalStr,
            pendencia: etapaPendente,
            dias: piorDia,
            tiragem: tiragem
        });
    });
    
    if(dadosExtraidos.length === 0) { alert("Nenhum item filtrado para exportar."); return; }
    
    if(window.showToast) window.showToast("Gerando planilha com os filtros atuais...", "info");
    let btn = document.getElementById('btnExportarFiltrados');
    if(btn) { btn.innerText = "⏳ Gerando..."; btn.disabled = true; }
    
    google.script.run.withSuccessHandler(function(res) {
        if(btn) { btn.innerText = "📊 Exportar Filtrados (Sheets)"; btn.disabled = false; }
        if(res && res.success) {
            window.open(res.url, '_blank');
            if(window.showToast) window.showToast("Planilha gerada com sucesso!", "success");
        } else {
            alert("Erro ao gerar planilha: " + (res ? res.error : "Erro desconhecido"));
        }
    }).withFailureHandler(function(err) {
        if(btn) { btn.innerText = "📊 Exportar Filtrados (Sheets)"; btn.disabled = false; }
        alert("Erro no servidor: " + err);
    }).gerarPlanilhaGiroFiltrado(dadosExtraidos);
};

