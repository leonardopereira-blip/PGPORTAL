    <style>
        /* GLOBAIS */
        .scroller::-webkit-scrollbar { height: 8px; width: 8px; }
        .scroller::-webkit-scrollbar-thumb { background: #525252; border-radius: 4px; }
        .scroller::-webkit-scrollbar-track { background: transparent; }
        
        /* CORES DO MENU LATERAL */
        .menu-btn { color: #9ca3af; transition: all 0.2s; }
        .menu-btn:hover { background-color: #171717; color: white; }
        .menu-active { background-color: #dc2626 !important; color: white !important; font-weight: bold; }

        /* VISIBILIDADE */
        .view-section { width: 100%; height: 100%; display: none; flex-direction: column; }
        .view-visible { display: flex !important; }
        
        /* TOOLTIP GLOBAL */
        .tooltip-container { position: relative; display: inline-flex; }
        .tooltip-text { 
            visibility: hidden; opacity: 0; pointer-events: none;
            width: 200px; background-color: #000; color: #fff; text-align: left; 
            border-radius: 6px; padding: 8px; position: absolute; z-index: 999; 
            bottom: 125%; left: 50%; margin-left: -100px; font-size: 10px; 
            border: 1px solid #333; transition: opacity 0.2s; white-space: normal;
        }
        .tooltip-container:hover .tooltip-text { visibility: visible; opacity: 1; }

        /* ANIMAÇÃO */
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        .toast-enter { animation: slideIn 0.3s ease-out forwards; }
    </style>
</head>
<body class="bg-neutral-100 font-sans text-neutral-800 h-screen flex flex-col overflow-hidden relative">

    <div id="globalLoading" class="fixed inset-0 bg-black z-[9999] flex flex-col items-center justify-center text-white transition-opacity duration-500">
