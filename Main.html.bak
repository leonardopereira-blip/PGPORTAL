    <script>
        var formatarNum = (num) => new Intl.NumberFormat('pt-BR').format(num || 0);
        var parseNumBR = (val) => {
            if (!val) return 0;
            let s = String(val).trim();
            if (s === "" || s === "-") return 0;
            s = s.replace(/\./g, '').replace(',', '.');
            let n = Number(s);
            return isNaN(n) ? 0 : n;
        };

        function formatarDataHoraPortal(valor) {
            if (!valor) return '-';
            const d = valor instanceof Date ? valor : new Date(valor);
            if (isNaN(d.getTime())) return '-';
            return d.toLocaleString('pt-BR', {
                day: '2-digit', month: '2-digit', year: '2-digit',
                hour: '2-digit', minute: '2-digit'
            });
        }

        function atualizarRodapeDatas(f5, base) {
            const el = document.getElementById('txtDataAtualizacao');
            if (!el) return;
            el.innerHTML = `<span class="block">F5: ${formatarDataHoraPortal(f5)}</span><span class="block text-[10px] text-neutral-500">Base: ${formatarDataHoraPortal(base)}</span>`;
        }

        document.addEventListener('DOMContentLoaded', function() {
            carregarSistema();
            google.script.run.registrarAcessoUsuario();
        });

        // O cache do dashboard e fatiado por mes da coleta final (re) plan: cada RPC traz uma fatia,
        // e a tela só é liberada depois que todas as fatias estiverem completas.
        const PG_DASH_LS_PREFIXO = 'PG_DASH_MES_';
        const PG_DASH_LS_INDICE = 'PG_DASH_INDICE';

        function pgGuardarFatiaLocal(mes, json) {
            try { localStorage.setItem(PG_DASH_LS_PREFIXO + mes, json); return true; }
            catch (e) { return false; } // cota estourada: seguimos sem copia local deste mes
        }

        function pgLimparFatiasLocais(mesesValidos) {
            try {
                const validos = new Set((mesesValidos || []).map(m => PG_DASH_LS_PREFIXO + m));
                Object.keys(localStorage)
                    .filter(k => k.indexOf(PG_DASH_LS_PREFIXO) === 0 && !validos.has(k))
                    .forEach(k => localStorage.removeItem(k));
                localStorage.removeItem('PG_DADOS_PCP_CACHE'); // monolito antigo
            } catch (e) {}
        }

        function pgLerDashboardLocal() {
            const dados = [];
            try {
                const indice = JSON.parse(localStorage.getItem(PG_DASH_LS_INDICE) || 'null');
                const meses = (indice && indice.meses || []).map(item => item.mes);
                if (!meses.length) return [];
                for (const mes of meses) {
                    const json = localStorage.getItem(PG_DASH_LS_PREFIXO + mes);
                    if (!json) return []; // não libera cache local incompleto
                    dados.push.apply(dados, JSON.parse(json));
                }
            } catch (e) {
                return [];
            }
            return dados;
        }

        // O portal só é liberado depois que TODAS as fatias mensais foram baixadas e consolidadas.
        async function carregarDashboardPorMes(aviso) {
            const rpc = (nome, ...args) => new Promise((resolve, reject) => {
                google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[nome](...args);
            });
            const comRetry = async (nome, ...args) => {
                let ultimoErro;
                for (let i = 0; i < 3; i++) {
                    try { return await rpc(nome, ...args); }
                    catch (erro) {
                        ultimoErro = erro;
                        await new Promise(r => setTimeout(r, 600 * (i + 1)));
                    }
                }
                throw ultimoErro;
            };

            const indice = JSON.parse(await comRetry('getDadosDashboardIndice'));
            const meses = (indice.meses || []).map(m => m.mes);
            if (!meses.length) throw new Error('Indice do dashboard sem meses.');
            window.PG_DASHBOARD_INDICE = indice;
            window.PG_DASHBOARD_COMPLETO = false;
            window.PG_DASHBOARD_RESTO = null;
            try { localStorage.setItem(PG_DASH_LS_INDICE, JSON.stringify(indice)); } catch (e) {}
            pgLimparFatiasLocais(meses);

            const fatias = new Array(meses.length);
            const falhas = [];
            let proximo = 0;
            let concluidos = 0;
            const qtdWorkers = Math.min(3, meses.length);

            const worker = async () => {
                while (true) {
                    const i = proximo++;
                    if (i >= meses.length) return;
                    try {
                        const json = await comRetry('getDadosDashboardMes', meses[i]);
                        const fatia = JSON.parse(json);
                        if (!Array.isArray(fatia)) throw new Error('Fatia mensal inválida: ' + meses[i]);
                        fatias[i] = fatia;
                        pgGuardarFatiaLocal(meses[i], json);
                    } catch (erro) {
                        falhas.push({ mes: meses[i], erro: String(erro) });
                    } finally {
                        concluidos++;
                        if (aviso) aviso(`dashboard ${concluidos}/${meses.length} meses`);
                    }
                }
            };

            await Promise.all(Array.from({ length: qtdWorkers }, () => worker()));
            if (falhas.length) {
                throw new Error('Falha ao carregar os meses: ' + falhas.map(f => f.mes).join(', '));
            }

            const todos = [];
            fatias.forEach(fatia => todos.push.apply(todos, fatia));
            window.PG_DASHBOARD_COMPLETO = true;
            if (aviso) aviso('');
            console.info('[DASHBOARD] Todas as fatias carregadas antes de liberar o portal:', todos.length, 'registros');
            return todos;
        }

        // PG_LOADING_TODOS_MESES_V1

        async function carregarSistema() {
            if (window.pgCarregamentoInicial) return;
            window.pgCarregamentoInicial = true;
            const inicio = performance.now();
            const bar = document.getElementById('loadingBar');
            const msg = document.getElementById('loadingMsg');
            const loading = document.getElementById('globalLoading');
            loading.classList.remove('hidden');
            const fontesCriticas = [
                ['carregarDashboardPorMes', 'DADOS_PCP_CACHE', () => carregarDashboardPorMes(m => { window.PG_DASHBOARD_PROGRESSO = m; })],
                ['getEmailUsuario', 'PG_USER_EMAIL'],
                ['getForecastsColetaPortal', 'PG_FORECAST_COLETA']
            ];
            const fontesBackground = [
                ['getDadosCockpit_Cache', 'DADOS_COCKPIT_INICIAL'],
                ['getDadosPreProducao_Cache', 'DADOS_PREPROD_CACHE'],
                ['getDadosMapaSaida_Cache', 'MAPA_SAIDA_CACHE'],
                ['getDadosQualidade_Cache', 'DADOS_QUALIDADE_CACHE'],
                ['getDadosPPM_Cache', 'DADOS_PPM_CACHE'],
                ['getDadosAlocacao_Cache', 'DADOS_ALOCACAO_CACHE'],
                ['getDadosChamados_Cache', 'DADOS_CHAMADOS_CACHE'],
                ['getDadosInspecaoCDs_Cache', 'DADOS_INSPECOES_CACHE']
            ];
            const totalFontes = fontesCriticas.length + fontesBackground.length;
            const resultados = {}, falhas = [];
            let completas = 0;
            window.PG_PERFORMANCE = { fontesMs: {} };
            const status = () => {
                const detalhe = window.PG_DASHBOARD_PROGRESSO ? ` — ${window.PG_DASHBOARD_PROGRESSO}` : '';
                if (msg) msg.textContent = `Carregando dados: ${completas}/${totalFontes} bases (${((performance.now() - inicio) / 1000).toFixed(1)}s)${detalhe}`;
                if (bar) bar.style.width = Math.round(completas / totalFontes * 90) + '%';
            };
            status();
            const timer = setInterval(status, 250);
            const buscar = (nome, ...args) => new Promise((resolve, reject) => {
                google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[nome](...args);
            });
            const buscarComRetry = async (nome, tentativas = 2) => {
                let ultimoErro;
                for (let i = 0; i < tentativas; i++) {
                    try { return await buscar(nome); }
                    catch (erro) {
                        ultimoErro = erro;
                        await new Promise(resolve => setTimeout(resolve, 600 * (i + 1)));
                    }
                }
                throw ultimoErro;
            };
            const carregarFonte = async ([nome, chave, buscador], obrigatoria = false) => {
                const t = performance.now();
                try {
                    let valor = buscador
                        ? await buscador()
                        : (obrigatoria ? await buscarComRetry(nome, 3) : await buscar(nome));
                    if (typeof valor === 'string' && chave !== 'PG_USER_EMAIL') valor = JSON.parse(valor);
                    if (valor && valor._ERRO_CRITICO) throw new Error(valor._ERRO_CRITICO);
                    if (valor == null) throw new Error('Resposta vazia');
                    resultados[chave] = valor;
                    window[chave] = valor;
                    // O dashboard guarda copia local por fatia dentro de carregarDashboardPorMes.
                    if (chave === 'DADOS_COCKPIT_INICIAL' && typeof renderCockpit === 'function') renderCockpit(valor);
                } catch (erro) {
                    if (chave === 'DADOS_PCP_CACHE') {
                        const valorSalvo = pgLerDashboardLocal();
                        if (valorSalvo.length) {
                            resultados[chave] = valorSalvo;
                            window[chave] = valorSalvo;
                            console.warn('[CARREGAMENTO] Dashboard via fatias salvas no navegador por falha no RPC:', erro);
                            return;
                        }
                    }
                    falhas.push({ nome, erro: String(erro) });
                    console.warn('[CARREGAMENTO BG]', nome, erro);
                    if (obrigatoria) throw erro;
                }
                window.PG_PERFORMANCE.fontesMs[nome] = Math.round(performance.now() - t);
                completas++; status();
            };
            try {
                await Promise.all(fontesCriticas.map(f => carregarFonte(f, true)));
                Object.assign(window, resultados);
                const email = String(window.PG_USER_EMAIL || '').replace(/^"|"$/g, '').trim();
                window.PG_USER_EMAIL = email;
                document.getElementById('userEmail').textContent = email;
                if (email.toLowerCase() !== 'leonardo.pereira@arcoeducacao.com.br') {
                    document.querySelectorAll('#btnEnviarPendencias').forEach(b => b.style.display = 'none');
                }
                if (msg) msg.textContent = 'Preparando os dados e o painel...';
                const processamento = performance.now();
                iniciarDashboard(window.DADOS_PCP_CACHE);
                window.PG_PERFORMANCE.processamentoInicialMs = Math.round(performance.now() - processamento);
                window.PG_PERFORMANCE.inicialCompletoMs = Math.round(performance.now() - inicio);
                window.pgCarregamentoInicial = false;
                if (bar) bar.style.width = '100%';
                loading.classList.add('hidden');
                const dataF5 = new Date();
                atualizarRodapeDatas(dataF5, null);
                google.script.run
                    .withSuccessHandler(meta => atualizarRodapeDatas(dataF5, meta && meta.atualizadoEm))
                    .withFailureHandler(() => atualizarRodapeDatas(dataF5, null))
                    .getMetadadosCachePortal();
                console.info('[PERFORMANCE] Portal completo:', window.PG_PERFORMANCE);
                showToast(`Dados carregados em ${(window.PG_PERFORMANCE.inicialCompletoMs / 1000).toFixed(1)}s`, 'success', 'Carregamento concluído');
                let bgIndex = 0;
                const bgWorker = async () => {
                    while (bgIndex < fontesBackground.length) {
                        await carregarFonte(fontesBackground[bgIndex++]);
                    }
                };
                if (window.PG_DASHBOARD_RESTO) {
                    window.PG_DASHBOARD_RESTO
                        .then(total => {
                            const meses = (window.PG_DASHBOARD_INDICE && window.PG_DASHBOARD_INDICE.meses || []).length;
                            showToast(`${formatarNum(total)} registros em ${meses} meses`, 'success', 'Dashboard completo');
                        })
                        .catch(erro => {
                            console.error('[DASHBOARD] Falha ao liberar fatias:', erro);
                            showToast('Alguns meses não foram carregados. Atualize a página.', 'error', 'Dashboard incompleto');
                        });
                }
                Promise.all(Array.from({ length: 3 }, bgWorker)).then(() => {
                    clearInterval(timer);
                    console.info('[PERFORMANCE] Bases em segundo plano:', window.PG_PERFORMANCE);
                });
            } catch (erro) {
                clearInterval(timer);
                window.pgCarregamentoInicial = false;
                if (msg) msg.textContent = 'Não foi possível carregar todos os dados. Atualize para tentar novamente.';
                console.error('[CARREGAMENTO]', erro);
            }
        }

        function navegarView(viewId, btnElement) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('view-visible'));
            document.getElementById(viewId).classList.add('view-visible');
            document.querySelectorAll('.menu-btn').forEach(b => b.classList.remove('menu-active'));
            if(btnElement) btnElement.classList.add('menu-active');
            if(viewId === 'viewPreProd') {
                setTimeout(() => {
                    if(typeof receberDadosPreProd === 'function' && window.DADOS_PREPROD_CACHE) {
                        receberDadosPreProd(window.DADOS_PREPROD_CACHE);
                    } 
                    else if(typeof carregarPreProducao === 'function') {
                        carregarPreProducao();
                    }
                }, 100);
            }
            window.dispatchEvent(new Event('resize'));
        }

        function abrirGrafico(graficoId, btnElement) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('view-visible'));
            document.getElementById('viewDash').classList.add('view-visible');
            document.querySelectorAll('.menu-btn').forEach(b => { b.classList.remove('menu-active'); });
            if(btnElement) btnElement.classList.add('menu-active');
            if(typeof window.alternarAbaDash === 'function') {
                window.alternarAbaDash(graficoId);
            }
        }

        function toggleMenu() {
            var sb = document.getElementById('sidebarMenu');
            if(sb.classList.contains('w-64')) {
                sb.classList.remove('w-64');
                sb.classList.add('w-0');
            } else {
                sb.classList.remove('w-0');
                sb.classList.add('w-64');
            }
            setTimeout(() => window.dispatchEvent(new Event('resize')), 300); 
        }

        function toggleSubmenuMenu(subId, iconId) {
            const sub = document.getElementById(subId);
            const icon = document.getElementById(iconId);
            if (sub.classList.contains('hidden')) {
                sub.classList.remove('hidden');
                sub.classList.add('flex');
                icon.style.transform = 'rotate(180deg)';
            } else {
                sub.classList.add('hidden');
                sub.classList.remove('flex');
                icon.style.transform = 'rotate(0deg)';
            }
        }

        function setLoading(ativo, msgText) {
            const el = document.getElementById('globalLoading');
            if (!ativo && window.pgCarregamentoInicial) return;
            if(msgText) document.getElementById('loadingMsg').innerText = msgText;
            if(ativo) el.classList.remove('hidden'); else el.classList.add('hidden');
        }

        let toastTimeout;
        function showToast(msg, type = 'success', title = null) {
            const box = document.getElementById('toastBox');
            if(!box) return;
            box.classList.remove('hidden');
            document.getElementById('toastTitle').innerText = title || ((type === 'success') ? "Sucesso!" : "Atenção");
            document.getElementById('toastMsg').innerText = msg;
            if(toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => box.classList.add('hidden'), 20000);
        }

        function hideToast() {
            const box = document.getElementById('toastBox');
            if(box) box.classList.add('hidden');
        }

        window.arredondar = function(valor) {
            if (!valor) return 0;
            if (typeof valor === 'number') return Math.round(valor);
            let textoLimpo = String(valor).replace(/\./g, '').replace(',', '.');
            return Math.round(parseFloat(textoLimpo)) || 0;
        };

        window.formatarBR = function(valor) {
            return window.arredondar(valor).toLocaleString('pt-BR');
        };

        // REGRA DE PENDÊNCIAS MAPA / PCP E EXPORTADOR DO GIRO
        window.exportarGiroCSV = function() {
            var tabela = document.getElementById('tbodyPontosAtencaoGiro');
            if (!tabela) { alert("Tabela de pendências não encontrada."); return; }
            var linhas = tabela.querySelectorAll('tr');
            var csv = "\uFEFFGráfica;Marca;Série;Status Geral;Etapa Pendente;Qtd SKUs;Tiragem Total\n";
            linhas.forEach(function(tr) {
                var tds = tr.querySelectorAll('td');
                if (tds.length >= 8) {
                    var graf = tds[1] ? tds[1].innerText.trim() : '';
                    var marc = tds[2] ? tds[2].innerText.trim() : '';
                    var ser  = tds[3] ? tds[3].innerText.trim() : '';
                    var st   = tds[4] ? tds[4].innerText.trim() : '';
                    var pend = tds[5] ? tds[5].innerText.replace(/\n/g, ' ').trim() : '';
                    var qtd  = tds[6] ? tds[6].innerText.trim() : '';
                    var tir  = tds[7] ? tds[7].innerText.trim() : '';
                    csv += `"${graf}";"${marc}";"${ser}";"${st}";"${pend}";"${qtd}";"${tir}"\n`;
                }
            });
            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `Giro_Semanal_Pendencias_${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
        };

        window.avaliarPendenciasMapaPCP = function(item) {
            var stColeta = String(item["STATUS_COLETA"] || item["STATUS_EE"] || "").toUpperCase().trim();
            var dtDz = item["DATA_DZ"] || item["DATA_EA"];
            var pendencias = [];

            // Regra 1: Status 'Coleta Pendente' e Data Coleta Real preenchida
            if (stColeta.includes("PENDENTE") && dtDz) {
                pendencias.push("Coleta mapa pendente");
            }
            // Regra 2: Status 'Coletado a Menos'
            if (stColeta.includes("MENOS") || stColeta.includes("DIVERGENTE")) {
                pendencias.push("Tiragem mapa divergente do PCP");
            }
            return pendencias;
        };
        
        // INTEGRAÇÃO GOOGLE SHEETS & NOVAS REGRAS DE PENDÊNCIA DO GIRO
        window.exportarGiroGSheets = function() {
            var tabela = document.getElementById('tbodyPontosAtencaoGiro');
            if (!tabela) { alert("Tabela de pendências não encontrada."); return; }
            var linhas = tabela.querySelectorAll('tr');
            var dados = [];
            linhas.forEach(function(tr) {
                var tds = tr.querySelectorAll('td');
                if (tds.length >= 8) {
                    dados.push({
                        grafica: tds[1] ? tds[1].innerText.trim() : '',
                        marca: tds[2] ? tds[2].innerText.trim() : '',
                        serie: tds[3] ? tds[3].innerText.trim() : '',
                        status: tds[4] ? tds[4].innerText.trim() : '',
                        pendencia: tds[5] ? tds[5].innerText.replace(/\n/g, ' ').trim() : '',
                        qtd: tds[6] ? tds[6].innerText.trim() : '',
                        tiragemTotal: tds[7] ? tds[7].innerText.trim() : ''
                    });
                }
            });
            if (dados.length === 0) { alert("Nenhuma pendência exibida para exportar."); return; }
            if (window.showToast) window.showToast("Gerando arquivo no Google Sheets...", "info");
            
            google.script.run.withSuccessHandler(function(res) {
                if (res && res.success && res.url) {
                    window.open(res.url, '_blank');
                    if (window.showToast) window.showToast("Google Sheet criado com sucesso!", "success");
                } else {
                    alert("Erro ao criar planilha: " + (res ? res.error : "Erro desconhecido"));
                }
            }).withFailureHandler(function(err) {
                alert("Erro no servidor: " + err);
            }).exportarGiroGSheets(dados);
        };

        window.avaliarNovasPendenciasGiro = function(item) {
            var novaspend = [];
            var stColeta = String(item["STATUS_COLETA"] || item["STATUS_EE"] || item["stColeta"] || "").toUpperCase().trim();
            var dtDz = item["DATA_DZ"] || item["DATA_EA"] || item["dtColetaReal"] || item["dataColeta"];
            var volAz = parseFloat(item["VOLUME_AZ"] || item["volColetado"] || 0);
            var volTotal = parseFloat(item["TIRAGEM"] || item["QUANTIDADE"] || item["VOLUME_TOTAL"] || 0);

            // Regra 1: 'Coleta mapa pendente' -> Status Coleta Pendente mas Data Coleta Real preenchida
            if ((stColeta.includes("PENDENTE") || stColeta === "COLETA PENDENTE") && dtDz && String(dtDz).trim() !== "" && String(dtDz).trim() !== "-") {
                novaspend.push("Coleta mapa pendente");
            }

            // Regra 2: 'Tiragem mapa divergente do PCP' -> Status 'Coletado a Menos' ou volumes divergentes
            if (stColeta.includes("MENOS") || stColeta.includes("COLETADO A MENOS") || stColeta.includes("DIVERGENTE") || (volAz > 0 && volAz !== volTotal)) {
                novaspend.push("Tiragem mapa divergente do PCP");
            }

            return novaspend;
        };
        



// =========================================================
// EXPORTAÇÃO EXATA DO QUE ESTÁ FILTRADO NA TELA DO GIRO
// =========================================================
window.exportarSkusFiltradosSheets = function() {
    if (!window.GIRO_DADOS_RAW || window.GIRO_DADOS_RAW.length === 0) { alert("Sem dados carregados."); return; }
    
    const optAberto = document.getElementById('chkGiroAberto').checked;
    const optConcluido = document.getElementById('chkGiroConcluido').checked;
    const optCancelado = document.getElementById('chkGiroCancelado').checked;
    const minDias = parseInt(document.getElementById('sldGiroDiasMin').value);
    const maxDias = parseInt(document.getElementById('sldGiroDiasMax').value);
    const minR = Math.min(minDias, maxDias);
    const maxR = Math.max(minDias, maxDias);
    
    const ETAPAS_MAPA_FILTRO = [
      { nome: 'Env. Arquivo', plan: ['ENV ARQUIVO PLAN'], real: ['ENV ARQUIVO REAL'] },
      { nome: 'Rec. Boneco', plan: ['REC BONECO PLAN'], real: ['REC BONECO REAL'] },
      { nome: 'Apv. Boneco', plan: ['APV BONECO PLAN'], real: ['APV BONECO REAL'] },
      { nome: 'Impressão (Início)', plan: ['Impressão Inicio (re) plan'], real: ['Impressão Inicio Real'] },
      { nome: 'Impressão (Fim)', plan: ['Impressão Final (re) plan'], real: ['Impressão Final Real.', 'Impressão Final Real'] },
      { nome: 'Val. Custos (Início)', plan: ['Validação de Custo inicial (re) plan'], real: ['Validação de Custo inicial Real'] },
      { nome: 'Val. Custos (Fim)', plan: ['Validação de Custo final (re) plan'], real: ['Validação de Custo Final Real'] },
      { nome: 'O.C. (Início)', plan: ['OC inicial (re) plan'], real: ['OC inicial Real'] },
      { nome: 'O.C. (Fim)', plan: ['OC final (re) plan'], real: ['OC Final Real'] },
      { nome: 'Acabamento (Início)', plan: ['Acbto Inicio (re) plan'], real: ['Acbto Inicio Real'] },
      { nome: 'Acabamento (Fim)', plan: ['Acbto Final (re) plan'], real: ['Acbto Final Real'] },
      { nome: 'Form. Kit (Início)', plan: ['Formação de kit/Encaixotamento início (re) plan'], real: ['Formação de kit/Encaixotamento Início Real'] },
      { nome: 'Form. Kit (Fim)', plan: ['Formação de kit/Encaixotamento Final (re) plan'], real: ['Formação de kit/Encaixotamento Final Real'] },
      { nome: 'Coleta Inicial', plan: ['Coleta/Internalização de estoque inicial (re) plan'], real: ['Coleta/Internalização de estoque inicial Real'] },
      { nome: 'Coleta Final', plan: ['Coleta/Internalização de estoque final (re) plan'], real: ['Coleta/Internalização de estoque Final Real', 'Coleta Real PCP', 'Data coleta', 'Data da coleta realizada'] }
    ];
    
    function getVal(row, cols) { for (let c of cols) { if (row[c] !== undefined && row[c] !== null) return row[c]; } return null; }
    function isDateFilled(val) { if (val == null) return false; let s = String(val).trim().toUpperCase(); return s !== '' && s !== '-' && s !== 'N/A' && !s.includes('SEM DATA'); }
    function parseValidDate(val) { if(!isDateFilled(val)) return null; if(typeof val.getTime === 'function') return val; let str=String(val).trim(); if(str.includes('/')){ let p=str.split(' ')[0].split('/'); if(p.length===3) return new Date(p[2],p[1]-1,p[0],0,0,0); } let d = new Date(str); return isNaN(d.getTime())?null:d; }

    let dadosExtraidos = [];
    
    window.GIRO_DADOS_RAW.forEach(l => {
        let statusEE = String(l["STATUS_EE"] || "").trim().toUpperCase();
        if (statusEE === "OK" || statusEE === "NÃO COLETADO" || statusEE === "NAO COLETADO") return;

        let statusFinalStr = 'Em Aberto';
        let ultEtapaStatus = String(l["Última Etapa"] || l["STATUS"] || l["Etapa Atual"] || "").toUpperCase();
        let coletaReal = getVal(l, ['Coleta/Internalização de estoque Final Real', 'Coleta Real PCP', 'Data coleta', 'Data da coleta realizada', 'DT_ENTREGA_DG']);
        
        if (ultEtapaStatus.includes("CANCEL")) statusFinalStr = 'Cancelado';
        else if (ultEtapaStatus.includes("CONCLU") || ultEtapaStatus.includes("FINALIZADO") || isDateFilled(coletaReal)) statusFinalStr = 'Concluído';

        // Respeita os checkboxes superiores (Em aberto, concluído, cancelado)
        if (statusFinalStr === 'Concluído' && !optConcluido) return;
        if (statusFinalStr === 'Cancelado' && !optCancelado) return;
        if (statusFinalStr === 'Em Aberto' && !optAberto) return;
        
        let etapaPendente = '-';
        let piorDia = 0;
        
        if (statusFinalStr === 'Em Aberto') {
            let selecionadas = [];
            for (let i = 0; i < ETAPAS_MAPA_FILTRO.length; i++) {
                let e = ETAPAS_MAPA_FILTRO[i];
                let valReal = getVal(l, e.real);
                let valPlan = getVal(l, e.plan);

                if (!isDateFilled(valReal) && isDateFilled(valPlan)) {
                    let dPlan = parseValidDate(valPlan);
                    if (dPlan) {
                        let dHoje = new Date(); dHoje.setHours(0,0,0,0); dPlan.setHours(0,0,0,0);
                        let dias = Math.floor((dHoje - dPlan) / 86400000);
                        let esc = -dias;
                        
                        // Respeita OS BOTÕES que você clicou E o SLIDER de dias
                        if (window.GIRO_ETAPAS_SELECIONADAS && window.GIRO_ETAPAS_SELECIONADAS.has(e.nome) && esc >= minR && esc <= maxR) {
                            selecionadas.push({ nome: e.nome, dias: esc });
                        }
                    }
                }
            }
            if (selecionadas.length === 0) return; // Não atende filtros visuais
            etapaPendente = selecionadas.map(s => s.nome).join(' + ');
            piorDia = Math.min(...selecionadas.map(s => s.dias));
        }

        let desc = l["DESC_REAL"] || l["DESCRIÇÃO"] || l["PRODUTO"] || "-";
        let tiragem = window.arredondar ? window.arredondar(l["TIRAGEM"] || l["QUANTIDADE"] || 0) : 0;
        
        dadosExtraidos.push({
            grafica: String(l["GRAFICA_FINAL"] || l["GRÁFICA"] || "N/A").trim(),
            marca: String(l["UNIDADE"] || l["MARCA_FINAL"] || "N/A").trim(),
            serie: String(l["SÉRIE"] || l["Série"] || l["SERIE"] || "-").trim(),
            sku: String(l["SKU_REAL"] || l["SKU"] || "-").trim(),
            desc: desc,
            status: statusFinalStr,
            pendencia: etapaPendente,
            dias: piorDia,
            tiragem: tiragem
        });
    });
    
    if(dadosExtraidos.length === 0) { alert("Nenhum item filtrado para exportar."); return; }
    
    if(window.showToast) window.showToast("Gerando planilha com os filtros atuais...", "info");
    let btn = document.getElementById('btnExportarFiltrados');
    if(btn) { btn.innerText = "⏳ Gerando..."; btn.disabled = true; }
    
    google.script.run.withSuccessHandler(function(res) {
        if(btn) { btn.innerText = "📊 Exportar Filtrados (Sheets)"; btn.disabled = false; }
        if(res && res.success) {
            window.open(res.url, '_blank');
            if(window.showToast) window.showToast("Planilha gerada com sucesso!", "success");
        } else {
            alert("Erro ao gerar planilha: " + (res ? res.error : "Erro desconhecido"));
        }
    }).withFailureHandler(function(err) {
        if(btn) { btn.innerText = "📊 Exportar Filtrados (Sheets)"; btn.disabled = false; }
        alert("Erro no servidor: " + err);
    }).gerarPlanilhaGiroFiltrado(dadosExtraidos);
};

</script>

<!-- HOOK_INJECTION_START -->
<script>
(function() {
    // A. Força o filtro de ENVIO a vir flegado APENAS com 'V1'
    function aplicarFiltroEnvioV1() {
        ['selFiltros', 'selFiltrosCK', 'selecoesFiltrosPre', 'selFiltrosProducao'].forEach(function(nomeVar) {
            if (window[nomeVar]) {
                window[nomeVar]['envio'] = ['V1'];
            }
        });
    }

    // B. Desmarca exatamente as 4 fases do Funil solicitadas
    function desmarcarFasesFunil() {
        var fasesDesmarcar = ["Transf. Acab", "Rec. Acab", "Rec. Acab.", "Coleta PCP", "Coleta TP"];
        var checkboxes = document.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(function(cb) {
            var parentText = cb.parentElement ? cb.parentElement.innerText.trim() : "";
            var valText = cb.value ? cb.value.trim() : "";
            var match = fasesDesmarcar.some(function(f) {
                return parentText.indexOf(f) !== -1 || valText.indexOf(f) !== -1;
            });
            if (match) {
                cb.checked = false;
            }
        });
    }

    function rodarAjustesFiltro() {
        aplicarFiltroEnvioV1();
        desmarcarFasesFunil();
        if (typeof aplicarFiltros === 'function') aplicarFiltros();
        if (typeof processarFunil === 'function') processarFunil();
    }



    // C. Exportador Nativo Google Sheets para o Giro Semanal
    window.exportarGiroGSheets = function() {
        var tabela = document.getElementById('tbodyPontosAtencaoGiro');
        if (!tabela) { alert("Tabela de pendências não encontrada."); return; }
        var linhas = tabela.querySelectorAll('tr');
        var dados = [];
        linhas.forEach(function(tr) {
            var tds = tr.querySelectorAll('td');
            if (tds.length >= 8) {
                dados.push({
                    grafica: tds[1] ? tds[1].innerText.trim() : '',
                    marca: tds[2] ? tds[2].innerText.trim() : '',
                    serie: tds[3] ? tds[3].innerText.trim() : '',
                    status: tds[4] ? tds[4].innerText.trim() : '',
                    pendencia: tds[5] ? tds[5].innerText.replace(/\n/g, ' ').trim() : '',
                    qtd: tds[6] ? tds[6].innerText.trim() : '',
                    tiragemTotal: tds[7] ? tds[7].innerText.trim() : ''
                });
            }
        });
        if (dados.length === 0) { alert("Nenhuma pendência exibida para exportar."); return; }
        if (window.showToast) window.showToast("Gerando planilha no Google Sheets...", "info");

        google.script.run.withSuccessHandler(function(res) {
            if (res && res.success && res.url) {
                window.open(res.url, '_blank');
                if (window.showToast) window.showToast("Google Sheet gerado com sucesso!", "success");
            } else {
                alert("Erro ao criar planilha: " + (res ? res.error : "Desconhecido"));
            }
        }).withFailureHandler(function(err) {
            alert("Erro no servidor: " + err);
        }).exportarGiroGSheets(dados);
    };

    // D. Regras adicionais de pendência no Giro
    window.avaliarNovasPendenciasGiro = function(item) {
        var pendencias = [];
        var stColeta = String(item["STATUS_COLETA"] || item["STATUS_EE"] || item["stColeta"] || "").toUpperCase().trim();
        var dtDz = item["DATA_DZ"] || item["DATA_EA"] || item["dtColetaReal"] || item["dataColeta"];
        var volAz = parseFloat(item["VOLUME_AZ"] || item["volColetado"] || 0);
        var volTotal = parseFloat(item["TIRAGEM"] || item["QUANTIDADE"] || item["VOLUME_TOTAL"] || 0);

        if ((stColeta.indexOf("PENDENTE") !== -1) && dtDz && String(dtDz).trim() !== "" && String(dtDz).trim() !== "-") {
            pendencias.push("Coleta mapa pendente");
        }

        if (stColeta.indexOf("MENOS") !== -1 || stColeta.indexOf("DIVERGENTE") !== -1 || (volAz > 0 && volAz !== volTotal)) {
            pendencias.push("Tiragem mapa divergente do PCP");
        }

        return pendencias;
    };
})();




// =========================================================
// EXPORTAÇÃO EXATA DO QUE ESTÁ FILTRADO NA TELA DO GIRO
// =========================================================
window.exportarSkusFiltradosSheets = function() {
    if (!window.GIRO_DADOS_RAW || window.GIRO_DADOS_RAW.length === 0) { alert("Sem dados carregados."); return; }
    
    const optAberto = document.getElementById('chkGiroAberto').checked;
    const optConcluido = document.getElementById('chkGiroConcluido').checked;
    const optCancelado = document.getElementById('chkGiroCancelado').checked;
    const minDias = parseInt(document.getElementById('sldGiroDiasMin').value);
    const maxDias = parseInt(document.getElementById('sldGiroDiasMax').value);
    const minR = Math.min(minDias, maxDias);
    const maxR = Math.max(minDias, maxDias);
    
    const ETAPAS_MAPA_FILTRO = [
      { nome: 'Env. Arquivo', plan: ['ENV ARQUIVO PLAN'], real: ['ENV ARQUIVO REAL'] },
      { nome: 'Rec. Boneco', plan: ['REC BONECO PLAN'], real: ['REC BONECO REAL'] },
      { nome: 'Apv. Boneco', plan: ['APV BONECO PLAN'], real: ['APV BONECO REAL'] },
      { nome: 'Impressão (Início)', plan: ['Impressão Inicio (re) plan'], real: ['Impressão Inicio Real'] },
      { nome: 'Impressão (Fim)', plan: ['Impressão Final (re) plan'], real: ['Impressão Final Real.', 'Impressão Final Real'] },
      { nome: 'Val. Custos (Início)', plan: ['Validação de Custo inicial (re) plan'], real: ['Validação de Custo inicial Real'] },
      { nome: 'Val. Custos (Fim)', plan: ['Validação de Custo final (re) plan'], real: ['Validação de Custo Final Real'] },
      { nome: 'O.C. (Início)', plan: ['OC inicial (re) plan'], real: ['OC inicial Real'] },
      { nome: 'O.C. (Fim)', plan: ['OC final (re) plan'], real: ['OC Final Real'] },
      { nome: 'Acabamento (Início)', plan: ['Acbto Inicio (re) plan'], real: ['Acbto Inicio Real'] },
      { nome: 'Acabamento (Fim)', plan: ['Acbto Final (re) plan'], real: ['Acbto Final Real'] },
      { nome: 'Form. Kit (Início)', plan: ['Formação de kit/Encaixotamento início (re) plan'], real: ['Formação de kit/Encaixotamento Início Real'] },
      { nome: 'Form. Kit (Fim)', plan: ['Formação de kit/Encaixotamento Final (re) plan'], real: ['Formação de kit/Encaixotamento Final Real'] },
      { nome: 'Coleta Inicial', plan: ['Coleta/Internalização de estoque inicial (re) plan'], real: ['Coleta/Internalização de estoque inicial Real'] },
      { nome: 'Coleta Final', plan: ['Coleta/Internalização de estoque final (re) plan'], real: ['Coleta/Internalização de estoque Final Real', 'Coleta Real PCP', 'Data coleta', 'Data da coleta realizada'] }
    ];
    
    function getVal(row, cols) { for (let c of cols) { if (row[c] !== undefined && row[c] !== null) return row[c]; } return null; }
    function isDateFilled(val) { if (val == null) return false; let s = String(val).trim().toUpperCase(); return s !== '' && s !== '-' && s !== 'N/A' && !s.includes('SEM DATA'); }
    function parseValidDate(val) { if(!isDateFilled(val)) return null; if(typeof val.getTime === 'function') return val; let str=String(val).trim(); if(str.includes('/')){ let p=str.split(' ')[0].split('/'); if(p.length===3) return new Date(p[2],p[1]-1,p[0],0,0,0); } let d = new Date(str); return isNaN(d.getTime())?null:d; }

    let dadosExtraidos = [];
    
    window.GIRO_DADOS_RAW.forEach(l => {
        let statusEE = String(l["STATUS_EE"] || "").trim().toUpperCase();
        if (statusEE === "OK" || statusEE === "NÃO COLETADO" || statusEE === "NAO COLETADO") return;

        let statusFinalStr = 'Em Aberto';
        let ultEtapaStatus = String(l["Última Etapa"] || l["STATUS"] || l["Etapa Atual"] || "").toUpperCase();
        let coletaReal = getVal(l, ['Coleta/Internalização de estoque Final Real', 'Coleta Real PCP', 'Data coleta', 'Data da coleta realizada', 'DT_ENTREGA_DG']);
        
        if (ultEtapaStatus.includes("CANCEL")) statusFinalStr = 'Cancelado';
        else if (ultEtapaStatus.includes("CONCLU") || ultEtapaStatus.includes("FINALIZADO") || isDateFilled(coletaReal)) statusFinalStr = 'Concluído';

        // Respeita os checkboxes superiores (Em aberto, concluído, cancelado)
        if (statusFinalStr === 'Concluído' && !optConcluido) return;
        if (statusFinalStr === 'Cancelado' && !optCancelado) return;
        if (statusFinalStr === 'Em Aberto' && !optAberto) return;
        
        let etapaPendente = '-';
        let piorDia = 0;
        
        if (statusFinalStr === 'Em Aberto') {
            let selecionadas = [];
            for (let i = 0; i < ETAPAS_MAPA_FILTRO.length; i++) {
                let e = ETAPAS_MAPA_FILTRO[i];
                let valReal = getVal(l, e.real);
                let valPlan = getVal(l, e.plan);

                if (!isDateFilled(valReal) && isDateFilled(valPlan)) {
                    let dPlan = parseValidDate(valPlan);
                    if (dPlan) {
                        let dHoje = new Date(); dHoje.setHours(0,0,0,0); dPlan.setHours(0,0,0,0);
                        let dias = Math.floor((dHoje - dPlan) / 86400000);
                        let esc = -dias;
                        
                        // Respeita OS BOTÕES que você clicou E o SLIDER de dias
                        if (window.GIRO_ETAPAS_SELECIONADAS && window.GIRO_ETAPAS_SELECIONADAS.has(e.nome) && esc >= minR && esc <= maxR) {
                            selecionadas.push({ nome: e.nome, dias: esc });
                        }
                    }
                }
            }
            if (selecionadas.length === 0) return; // Não atende filtros visuais
            etapaPendente = selecionadas.map(s => s.nome).join(' + ');
            piorDia = Math.min(...selecionadas.map(s => s.dias));
        }

        let desc = l["DESC_REAL"] || l["DESCRIÇÃO"] || l["PRODUTO"] || "-";
        let tiragem = window.arredondar ? window.arredondar(l["TIRAGEM"] || l["QUANTIDADE"] || 0) : 0;
        
        dadosExtraidos.push({
            grafica: String(l["GRAFICA_FINAL"] || l["GRÁFICA"] || "N/A").trim(),
            marca: String(l["UNIDADE"] || l["MARCA_FINAL"] || "N/A").trim(),
            serie: String(l["SÉRIE"] || l["Série"] || l["SERIE"] || "-").trim(),
            sku: String(l["SKU_REAL"] || l["SKU"] || "-").trim(),
            desc: desc,
            status: statusFinalStr,
            pendencia: etapaPendente,
            dias: piorDia,
            tiragem: tiragem
        });
    });
    
    if(dadosExtraidos.length === 0) { alert("Nenhum item filtrado para exportar."); return; }
    
    if(window.showToast) window.showToast("Gerando planilha com os filtros atuais...", "info");
    let btn = document.getElementById('btnExportarFiltrados');
    if(btn) { btn.innerText = "⏳ Gerando..."; btn.disabled = true; }
    
    google.script.run.withSuccessHandler(function(res) {
        if(btn) { btn.innerText = "📊 Exportar Filtrados (Sheets)"; btn.disabled = false; }
        if(res && res.success) {
            window.open(res.url, '_blank');
            if(window.showToast) window.showToast("Planilha gerada com sucesso!", "success");
        } else {
            alert("Erro ao gerar planilha: " + (res ? res.error : "Erro desconhecido"));
        }
    }).withFailureHandler(function(err) {
        if(btn) { btn.innerText = "📊 Exportar Filtrados (Sheets)"; btn.disabled = false; }
        alert("Erro no servidor: " + err);
    }).gerarPlanilhaGiroFiltrado(dadosExtraidos);
};

</script>
<!-- HOOK_INJECTION_END -->





<!-- HOOK_FILTROS_E_REGRAS_START -->
<script>
(function() {
    function aplicarFiltrosPadraoForcados() {
        // A. Filtro ENVIO = V1
        ['selFiltros', 'selFiltrosCK', 'selecoesFiltrosPre', 'selFiltrosProducao'].forEach(function(v) {
            if (window[v]) window[v]['envio'] = ['V1'];
        });

        document.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
            var val = (cb.value || "").trim().toUpperCase();
            var label = cb.parentElement ? cb.parentElement.innerText.trim().toUpperCase() : "";
            if (val === 'V1' || label === 'V1') {
                cb.checked = true;
            } else if (['V2', 'V3', 'V4'].indexOf(val) !== -1 || ['V2', 'V3', 'V4'].indexOf(label) !== -1) {
                cb.checked = false;
            }
        });

        // B. Desmarca exatamente as 4 fases solicitadas no Funil
        var fasesDesmarcar = ["TRANSF. ACAB", "REC. ACAB", "REC. ACAB.", "COLETA PCP", "COLETA TP"];
        document.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
            var txt = (cb.value || "").trim().toUpperCase();
            var parentTxt = cb.parentElement ? cb.parentElement.innerText.trim().toUpperCase() : "";
            var deveDesmarcar = fasesDesmarcar.some(function(f) {
                return txt.indexOf(f) !== -1 || parentTxt.indexOf(f) !== -1;
            });
            if (deveDesmarcar) {
                cb.checked = false;
            }
        });

        if (typeof window.aplicarFiltros === 'function') window.aplicarFiltros();
        if (typeof window.processarFunil === 'function') window.processarFunil();
    }

    // Executa em múltiplos momentos para garantir que pegue o carregamento dos elementos


    // C. Exportador Nativo Google Sheets
    window.exportarGiroGSheets = function() {
        var tabela = document.getElementById('tbodyPontosAtencaoGiro');
        if (!tabela) { alert("Tabela de pendências não encontrada."); return; }
        var linhas = tabela.querySelectorAll('tr');
        var dados = [];
        linhas.forEach(function(tr) {
            var tds = tr.querySelectorAll('td');
            if (tds.length >= 8) {
                dados.push({
                    grafica: tds[1] ? tds[1].innerText.trim() : '',
                    marca: tds[2] ? tds[2].innerText.trim() : '',
                    serie: tds[3] ? tds[3].innerText.trim() : '',
                    status: tds[4] ? tds[4].innerText.trim() : '',
                    pendencia: tds[5] ? tds[5].innerText.replace(/\n/g, ' ').trim() : '',
                    qtd: tds[6] ? tds[6].innerText.trim() : '',
                    tiragemTotal: tds[7] ? tds[7].innerText.trim() : ''
                });
            }
        });
        if (dados.length === 0) { alert("Nenhuma pendência exibida para exportar."); return; }
        if (window.showToast) window.showToast("Gerando planilha no Google Sheets...", "info");

        google.script.run.withSuccessHandler(function(res) {
            if (res && res.success && res.url) {
                window.open(res.url, '_blank');
                if (window.showToast) window.showToast("Google Sheet gerado com sucesso!", "success");
            } else {
                alert("Erro ao criar planilha: " + (res ? res.error : "Desconhecido"));
            }
        }).withFailureHandler(function(err) {
            alert("Erro no servidor: " + err);
        }).exportarGiroGSheets(dados);
    };

    // D. Avaliador de Pendências do Giro
    window.avaliarNovasPendenciasGiro = function(item) {
        var pend = [];
        var stColeta = String(item["STATUS_COLETA"] || item["STATUS_EE"] || item["stColeta"] || "").toUpperCase().trim();
        var dtDz = item["DATA_DZ"] || item["DATA_EA"] || item["dtColetaReal"] || item["dataColeta"];
        var volAz = parseFloat(item["VOLUME_AZ"] || item["volColetado"] || 0);
        var volTotal = parseFloat(item["TIRAGEM"] || item["QUANTIDADE"] || item["VOLUME_TOTAL"] || 0);

        if ((stColeta.indexOf("PENDENTE") !== -1) && dtDz && String(dtDz).trim() !== "" && String(dtDz).trim() !== "-") {
            pend.push("Coleta mapa pendente");
        }

        if (stColeta.indexOf("MENOS") !== -1 || stColeta.indexOf("DIVERGENTE") !== -1 || (volAz > 0 && volAz !== volTotal)) {
            pend.push("Tiragem mapa divergente do PCP");
        }

        return pend;
    };
})();




